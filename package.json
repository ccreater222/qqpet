{
  "name": "qqpet",
  "productName": "QQPet",
  "version": "0.9.0",
  "description": "QQ 宠物跨平台复刻版（基于 Arctic Penguin T800 逆向重建）",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.harmony.json && tsc --noEmit -p tsconfig.e2e.json",
    "test:docs": "node --test scripts/docs/tests/*.test.mjs",
    "check:docs": "node scripts/docs/check-docs.mjs",
    "check:docs:staged": "node scripts/docs/check-docs.mjs --staged",
    "check:docs:range": "node scripts/docs/check-docs.mjs --range",
    "hooks:install": "node scripts/docs/install-hooks.mjs",
    "test:e2e": "node scripts/e2e/renderer-e2e.mjs",
    "smoke:compose": "node scripts/compose-smoke.mjs",
    "smoke:docker": "node scripts/docker-smoke.mjs",
    "smoke:proxy": "node scripts/e2e/proxy-smoke.mjs",
    "validate:evidence": "node scripts/validate-evidence.mjs",
    "gate:acceptance": "node scripts/acceptance-gate.mjs",
    "import-assets": "node scripts/import-assets.mjs",
    "prepare:ios-assets": "node scripts/prepare-ios-assets.mjs",
    "check:ios-assets": "node scripts/prepare-ios-assets.mjs --check",
    "build:ios-web": "vite build -c vite.ios.config.ts",
    "ios": "npm run typecheck && npm run build:ios-web && bash ios/build.sh",
    "test:compat": "node --experimental-strip-types --test --test-concurrency=1 scripts/tests/*.test.mjs",
    "dist": "npm run typecheck && electron-vite build && electron-builder --publish never",
    "build:android-web": "vite build -c vite.android.config.ts",
    "android": "npm run typecheck && npm run build:android-web && cd android && ./gradlew assembleDebug",
    "build:harmony-web": "vite build -c vite.harmony.config.ts",
    "harmony": "npm run typecheck && npm run build:harmony-web && node scripts/pack-harmony.mjs && cd harmony && ./hvigorw assembleHap -p product=default -p buildMode=debug",
    "test:e2e:main-process": "node scripts/e2e/run-e2e.mjs",
    "prepare": "node scripts/docs/install-hooks.mjs"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@babel/traverse": "^7.29.8",
    "@electron/asar": "^4.3.1",
    "@ruffle-rs/ruffle": "0.6.0",
    "@types/node": "^24.9.0",
    "binaryen": "123.0.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "koffi@3.3.3": true
  },
  "dependencies": {
    "koffi": "^3.3.3",
    "sherpa-onnx-node": "^1.13.8"
  }
}
