# Docker Compose / server environment reference. Put secrets in a secret file,
# never in this checked-in example.
QQPET_SYNC_BIND=127.0.0.1
QQPET_SYNC_PORT=8787
QQPET_SYNC_DB=/var/lib/qqpet-sync/qqpet.sqlite
QQPET_SYNC_BACKUP_DIR=/var/lib/qqpet-sync/backups
QQPET_SYNC_RESTORE_GENERATION_FILE=/var/lib/qqpet-sync/restore-generation.txt
QQPET_ADMIN_SOCKET=/var/lib/qqpet-sync/admin.sock
# Host CLI/systemd path; Docker Compose overrides this to its staged container path.
QQPET_OWNER_ADMIN_CREDENTIAL=/etc/qqpet-sync/owner-admin-credential
QQPET_SYNC_TIME_ZONE=Asia/Shanghai
QQPET_SYNC_WEATHER_LOCATION=北京
QQPET_SYNC_ADVANCE_WHILE_EMPTY=1
QQPET_SYNC_CATCHUP_CHUNK_TICKS=1440
QQPET_SYNC_COMMAND_RETENTION=10000
QQPET_SYNC_EVENT_RETENTION=10000
QQPET_SYNC_LOG_RETENTION_DAYS=30
QQPET_SYNC_MAX_FRAME_BYTES=16777216
QQPET_SYNC_MAX_COMMAND_BYTES=262144
QQPET_SYNC_MAX_PRE_AUTH_CONNECTIONS=64
QQPET_SYNC_LOG_LEVEL=info

# Docker Compose only. QQPET_OWNER_ADMIN_CREDENTIAL_FILE is required and has
# no checked-in default. It must contain the token of a non-revoked owner device
# paired to this authority, written as a 0600 host file before Compose starts:
#   umask 077
#   printf '%s\n' '<existing-owner-device-token>' > deploy/owner-admin-credential
#   chmod 0600 deploy/owner-admin-credential
QQPET_DOMAIN=pet.example.com
QQPET_OWNER_ADMIN_CREDENTIAL_FILE=./deploy/owner-admin-credential
